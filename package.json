{
  "name": "cafe-loyalty-rewards",
  "version": "1.0.0",
  "description": "Café Chain Loyalty Points Rewards System",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "install-all": "npm install && cd client && npm install && cd ..",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "supertest": "^7.1.1"
  }
}
